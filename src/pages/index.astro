---
import "../styles/global.css";
import PokemonCard from "../components/PokemonCard.astro";

interface Pokemon {
    name: string;
    url: string;
}

interface PokemonCardData {
    name: string;
    id: number;
    tipos: string[];
    sprite: string | null;
}

const Pokemones = await fetch(
    'https://pokeapi.co/api/v2/pokemon/?limit=135&offset=251'
);

const infoPokemon = await Pokemones.json();

const pokemones = await Promise.all(
    infoPokemon.results.map(async (pokemon: Pokemon) => {
        const respuesta = await fetch(pokemon.url);
        const datos = await respuesta.json();
        const tipos = datos.types.map((infoTipo: { type: { name: string } }) => infoTipo.type.name);

        return{
            name:datos.name,
            id:datos.id,
            tipos:tipos,
            sprite:datos.sprites.front_default,
        }
        
    })
);

---

<div class="grid grid-cols-3 gap-4">
    {pokemones.map((pokemon) => (
        <PokemonCard
		 name={pokemon.name}
		 id={pokemon.id}
         type={pokemon.tipos}
         sprite={pokemon.sprite}
		/>
    ))}
</div>