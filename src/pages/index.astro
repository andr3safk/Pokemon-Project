---
import "../styles/global.css";
import PokemonCard from "../components/PokemonCard.astro";
const Pokemones = await fetch('https://pokeapi.co/api/v2/pokemon/?limit=135&offset=251');
const infoPokemon = await Pokemones.json();

---

<div class="grid grid-cols-3 gap-4">
	{infoPokemon.results.map((pokemon) => (
  <PokemonCard name={pokemon.name} />
))}
</div>
