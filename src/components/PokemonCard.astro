---
import type { PokemonCardData } from "../types/pokemon";
import { colors } from "../constants/pokemonTypes";
import { capitalize } from "../lib/formatters";

interface Props extends PokemonCardData {}

const { name, id, type, sprite } = Astro.props;
---

<div class="border-2 border-slate-100 rounded-md flex flex-col shadow hover:scale-105 transition-transform duration-200">
    
    <div class="bg-slate-100 w-full h-46 flex items-center justify-center">
        <img src={sprite} alt={name} class="w-36 h-36 object-contain"/>
    </div>

    <div class="p-2 flex flex-col gap-2 bg-white">
        <p class="text-xs text-gray-500">{`#${id}`}</p>
        <h2 class="text-2xl">{capitalize(name)}</h2>
        <div class="flex gap-2">
            {type.map((t) => (
                <span class={`text-white text-xs px-2 py-1 rounded-md ${colors[t] ?? "bg-gray-400"}`}>
                    {capitalize(t)}
                </span>
            ))}
        </div>
    </div>
    
</div>