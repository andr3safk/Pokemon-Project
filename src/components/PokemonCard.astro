---
const { name, id, type, sprite } = Astro.props;
---

<div class="border-2 rounded-md p-6 flex flex-col items-center justify-center text-center">
    
    <div class="bg-slate-100">
        <img src={sprite} alt={name}/>
    </div>

    <div>
        <h1 class="text-2xl">{name}</h1>
        <p class="text-xl">{`#${id}`}</p>
        <p class="text-xl">{type.join(" / ")}</p>
    </div>
    
</div>